# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Official site origin, e.g. https://example.com (sitemap, robots, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=
# Optional: Google Analytics 4 measurement ID (G-XXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=
